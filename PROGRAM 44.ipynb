# SOLUTION 1 USING ENUMRATER

num = (12,44,33,5,32,43,22,333)
for index , value in enumerate(num ,start = 1):
    print(index ," :: ", value)


# SOLUTION 2 NOT USING ENUMRATER 
num = (22,44,66,3,22,2,45,533,56,4)
