    "THIRD MINI PROGRAM IN PYTHON PROGRAMMING \n",
    "\n",
    "PYTHON PROGRAM TO CALCULATE THE AREA OF TRIANGLE "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "d47a6962",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "THE AREA OF TRIANGLE IS  968.0\n"
     ]
    }
   ],
   "source": [
    "HEIGHT = float(input(\"ENTER THE HEIGHT OF TRIANGLE \" ))\n",
    "BASE = float(input(\"ENTER THE BASE OF TRIANGLE \"))\n",
    "area = (0.5) * BASE * HEIGHT\n",
    "print(\"THE AREA OF TRIANGLE IS \",area)\n"
   ]
  }
