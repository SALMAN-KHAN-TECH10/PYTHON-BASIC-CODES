   "source": [
    "### Python Program to Sort Words in Alphabetic Order (A B C)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "6ceecde1",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "the sorted words in alphabetic order is :: ['', 'can', 'for', 'hello', 'i', 'join', 'kens', 'party', 'the', 'you']\n"
     ]
    }
   ],
   "source": [
    "text = input(\"enter anything here ::\")\n",
    "split = text.split(\" \")\n",
    "for i in range(len(split)):\n",
    "    split[i] = split[i].lower()\n",
    "split.sort()\n",
    "print(f\"the sorted words in alphabetic order is :: {split}\")"
   ]
  }
 ],
