   "source": [
    "friends = {\"salman\":\"khan\" , \"ali\": \"shams\", \"awais\" : \"karni\"}\n",
    "name = input(\"enter the key here \")\n",
    "if name in friends.keys():\n",
    "    print(\"the key is present\")\n",
    "else:\n",
    "    print(\"not present \")"
   ]
